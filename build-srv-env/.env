UID=1000
GID=1000
USERNAME=builder
# Run `getent group docker` on the build server and put the GID here so the
# builder user can use the mounted /var/run/docker.sock without sudo.
DOCKER_GID=999
# Only relevant for podman-compose.yml: path to the host's Podman API socket.
PODMAN_SOCK=/run/podman/podman.sock
